# Copy to .env and edit. Real environment variables override these.

# Dashboard port
ENDLESS_PORT=8790

# Login for the dashboard, profile apps and live views.
# Set a password before exposing EndlessChrome through a tunnel (ngrok, cloudflared, Tailscale Funnel).
ENDLESS_USER=endless
ENDLESS_PASSWORD=

# Time zone the browsers and desktops report, e.g. Europe/Berlin (empty = UTC)
ENDLESS_TZ=

# Where profiles are stored (default ./data)
# ENDLESS_DATA=./data

# 127.0.0.1 = this machine only. 0.0.0.0 = reachable on your network (requires ENDLESS_PASSWORD).
ENDLESS_BIND=127.0.0.1

# Images for the two profile types
# ENDLESS_IMAGE=lscr.io/linuxserver/chromium:latest
# ENDLESS_OS_IMAGE=lscr.io/linuxserver/webtop:ubuntu-xfce
# ENDLESS_ANDROID_IMAGE=budtmo/docker-android:emulator_14.0

# windows/endless-on.ps1 also starts an ngrok tunnel when this is 1 (set a password first!)
ENDLESS_NGROK=0
